# Copy this file to .env and fill in your actual values

# Gemini AI Configuration
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_API_KEY_HERE

# ─── Video Source ───────────────────────────────────────────────────────────
# ค่า default: ใช้ webcam (use_webcam=true ใน config.development.json)
#
# เปลี่ยนเป็น RTSP กล้องจริง:
#   1. ตั้ง RTSP_VIDEO_PATH → จะ override อัตโนมัติ (use_webcam=false)
#   2. comment บรรทัดนี้ออก หรือลบ → กลับมาใช้ webcam
#
# RTSP_VIDEO_PATH=rtsp://user:password@192.168.1.100:554/stream1

# บังคับ webcam แม้จะตั้ง video_path ไว้ใน config (ไม่จำเป็นถ้าใช้ RTSP_VIDEO_PATH)
# USE_WEBCAM=true

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=helmet_detection