# Copy this file to .env and fill in your actual values

# Gemini AI Configuration
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_API_KEY_HERE

# ─── Video Source ───────────────────────────────────────────────────────────
# default: webcam (use_webcam=true in config.development.json)
#
# Change to RTSP camera:
#   1. Set RTSP_VIDEO_PATH → will override automatically (use_webcam=false)
#   2. Comment out this line or delete it → back to webcam
#
# RTSP_VIDEO_PATH=rtsp://user:password@192.168.1.100:554/stream1

# Force webcam even if video_path is set in config (not necessary if using RTSP_VIDEO_PATH)
# USE_WEBCAM=true

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=helmet_detection